# syntax=docker/dockerfile:1
#
# Build, test and lint the CLI.
#
# The host is not asked for a Rust toolchain, exactly as in meridian-core:
# everything runs here at a pinned version, so a contributor needs only Docker
# and every check is reproducible.
#
# git and ca-certificates because this crate's one dependency on the runtime is
# a git dependency at a pinned revision, which cargo fetches over HTTPS.

ARG RUST_VERSION=1.90
# The SDK image e2e-migrate is built on, and runs the migrations in.
ARG SDK_IMAGE=plugin-python:local

FROM rust:${RUST_VERSION}-slim-bookworm AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /w
COPY Cargo.toml Cargo.lock build.rs ./
COPY src/ src/
# What `meridian plugin new` writes, compiled into the binary.
COPY plugin-template/ plugin-template/

FROM base AS check
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/w/target \
    cargo build --locked

# Every check with a fake machine, the params file's refusals, and the
# argument parser. Nothing here reaches a cluster or a platform: what needs one
# is `make e2e-up`, against a real deployment.
FROM base AS test
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/w/target \
    cargo test --locked

FROM base AS lint
RUN rustup component add clippy rustfmt
RUN cargo fmt --all -- --check
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/w/target \
    cargo clippy --locked --all-targets -- -D warnings

# spec/the-cli, requirement 2: aws-lc-rs is the one dependency that compiles C,
# on any target. What builds C does it through cc, cmake or pkg-config, so a
# second C library shows up here as a second crate depending on one of them.
FROM base AS c-deps
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    found=$(for t in cc cmake pkg-config; do \
              cargo tree -q --locked --target all -e normal,build -i "$t" --depth 1 --prefix none 2>/dev/null; \
            done | cut -d' ' -f1 | grep -vxE 'cc|cmake|pkg-config' | sort -u | tr '\n' ' ') \
 && if [ "$found" != "aws-lc-sys " ]; then \
      echo "C is compiled by: ${found:-nothing}; spec/the-cli requirement 2 names aws-lc-sys alone" >&2; exit 1; \
    fi

# One artifact per target, built on that target's own runner: the release
# workflow runs this stage and takes the binary out of it.
FROM base AS release
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/w/target \
    cargo build --locked --release && cp target/release/meridian /meridian

# The install script, `meridian upgrade` and `uninstall`, against a stand-in
# for GitHub's releases (tests/install). The real binary, from `release`, is
# the one upgraded and uninstalled; tester is somebody who cannot write where
# it lives.
FROM debian:bookworm-slim AS install-test
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl python3 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home tester
COPY --from=release /meridian /usr/local/bin/meridian
COPY install.sh /w/install.sh
COPY tests/install/ /w/tests/install/
RUN sh /w/tests/install/run.sh

FROM koalaman/shellcheck-alpine:v0.10.0 AS shellcheck
COPY install.sh tests/install/run.sh /w/
RUN shellcheck --shell=sh /w/install.sh /w/run.sh

# The CLI as a person runs it, for the end-to-end run: the binary and the two
# tools it drives, helm and kubectl, at pinned versions and nothing else. It
# is not what anybody installs; `release` is.
FROM debian:bookworm-slim AS e2e
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=alpine/helm:3.16.2 /usr/bin/helm /usr/local/bin/helm
COPY --from=registry.k8s.io/kubectl:v1.35.0 /bin/kubectl /usr/local/bin/kubectl
# `meridian plugin upload` builds with docker, as it does on a person's own
# machine. The cluster run gives the pod the node's daemon, so these are the
# client alone: static binaries, and buildx, which `docker build` now is.
COPY --from=docker:29-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=release /meridian /usr/local/bin/meridian
ENTRYPOINT ["meridian"]

# `meridian plugin migrate`, the real binary, over the plugins meridian-python
# records its migrations for: `make e2e-migrate`, which hands in that
# checkout's tests/migrations and names the SDK image built from it. Not a
# release: Python, that SDK and pytest, for the check's --run-tests, git for
# each plugin's repository, and the docker client, given the host's daemon to
# build and run the migrations' image with.
FROM ${SDK_IMAGE} AS e2e-migrate
ARG SDK_IMAGE
ENV SDK_IMAGE=${SDK_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir pytest
COPY --from=docker:29-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=release /meridian /usr/local/bin/meridian
COPY --from=fixtures . /fixtures/
COPY tests/migrate/run.sh /e2e/run.sh
ENTRYPOINT ["sh", "/e2e/run.sh"]
